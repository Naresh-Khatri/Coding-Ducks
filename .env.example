# Local development env file.
# Copy this to `.env` at the repo root — every workspace script loads it via
# `dotenv -e ../../.env`:
#
#   cp .env.example .env
#
# The values below work out of the box with `make services` (local Postgres).
# Vars marked [placeholder ok] must be NON-EMPTY to pass env validation, but
# don't need real credentials unless you use that feature.
# Full walkthrough: SETUP.md
#
# This file is committed to version control — never put real secrets in it.

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml: Postgres is exposed on host port 5433 (not 5432).
POSTGRES_URL="postgres://dev:dev@localhost:5433/codingducks"

# ── Better Auth ──────────────────────────────────────────────────────────────
# Required — the hocuspocus server refuses to start without it.
# For anything non-local, generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET="local-dev-secret-change-me"

# OAuth — all four must be non-empty. You only need a REAL OAuth app for the
# provider you'll actually sign in with; leave placeholders for the other.
# GitHub OAuth app callback URL:  http://localhost:3001/api/auth/callback/github
BETTER_AUTH_GITHUB_ID="placeholder"
BETTER_AUTH_GITHUB_SECRET="placeholder"
# Google OAuth redirect URI:      http://localhost:3001/api/auth/callback/google
BETTER_AUTH_GOOGLE_ID="placeholder"
BETTER_AUTH_GOOGLE_SECRET="placeholder"

# ── URLs ─────────────────────────────────────────────────────────────────────
# The web app runs on port 3001 in dev (not 3000).
BASE_URL="http://localhost:3001"
# Must be a valid URL even in dev; any value works locally.
PRODUCTION_URL="https://example.com"

# ── Judge (code execution) ───────────────────────────────────────────────────
# JUDGE_API_URL is optional and defaults to the hosted judge:
#   https://judge.codingducks.xyz/api/v1
# JUDGE_API_URL=""
# Required non-empty. [placeholder ok] — Problem submissions and Playground
# runs will fail at runtime until you set a real token.
JUDGE_API_TOKEN="placeholder"

# ── Storage (Cloudflare R2, S3-compatible API) ───────────────────────────────
# All required non-empty; R2_ENDPOINT must be a valid URL. [placeholder ok] —
# only needed for file uploads and ducklet snapshots.
R2_BUCKET="placeholder"
R2_ACCOUNT_ID="placeholder"
R2_ACCESS_KEY_ID="placeholder"
R2_SECRET_ACCESS_KEY="placeholder"
R2_ENDPOINT="https://placeholder.r2.cloudflarestorage.com"

# ── Hocuspocus realtime server (collaborative ducklet editing) ───────────────
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
# Comma-separated WebSocket origin allowlist. Leave empty to allow all (dev).
# In production set to e.g. "https://app.example.com,https://example.com".
ALLOWED_WS_ORIGINS=""
# Realtime ducklet events go over an SSE tRPC subscription (ducklet.onEvent)
# backed by an in-process bus — no extra env needed.

# ── Optional ─────────────────────────────────────────────────────────────────
# Codestral key for AI ghost-text completion in the editor.
# Leave empty to disable the feature (everything else works fine).
MISTRAL_API_KEY=""

# Umami analytics. Leave both empty to disable — the script tag is only
# injected when both values are set.
# Cloud example: NEXT_PUBLIC_UMAMI_SRC="https://cloud.umami.is/script.js"
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
